+STALE_DATABASE_MESSAGE = (
+    "The database hasn't been updated for this version of QuadStack yet. "
+    "Restart the API so it can apply the update (run: docker compose restart api), "
+    "then try again."
+)
+
+
+async def database_error_handler(request: Request, exc: ProgrammingError) -> JSONResponse:
+    """Explain the common "database is behind the code" crash instead of a bare 500.
+
+    The API reloads code changes instantly, but database updates (migrations) only run
+    when the API starts. If new code that needs a new column or table is running before
+    that update, every query on it fails with "... does not exist".
+    """
+    logger.error("Database error on %s %s: %s", request.method, request.url.path, exc)
+    text = str(exc)
+    if "does not exist" in text and ("column" in text or "relation" in text):
+        return JSONResponse(
+            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
+            content={"detail": STALE_DATABASE_MESSAGE},
+        )
+    return JSONResponse(
+        status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
+        content={"detail": "Internal server error"},
+    )
