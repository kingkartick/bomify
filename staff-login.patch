+/**
+ * Message for a failed sign-in. Tells "wrong password" apart from "the server isn't
+ * working", which would otherwise both show up as a vague "Login failed".
+ */
+export function describeLoginError(err: unknown): string {
+  const response = (err as { response?: { status?: number; data?: { detail?: unknown } } })
+    ?.response;
+
+  const detail = response?.data?.detail;
+  if (typeof detail === "string") return detail;
+
+  if (!response) {
+    return "Can't reach the QuadStack server. Check that it is running, then try again.";
+  }
+  if (response.status !== undefined && response.status >= 500) {
+    return (
+      `The server ran into a problem (error ${response.status}). If you just updated QuadStack, ` +
+      "restart the API: run docker compose restart api. If it keeps happening, check " +
+      "docker compose logs api."
+    );
+  }
+  return "Login failed";
+}
