# Copy to .env.billing on the server and fill in. Never commit .env.billing.

PRODUCT_NAME=QuadStack
BILLING_PORT=9000

# Razorpay: Dashboard -> Account & Settings -> API Keys (use rzp_test_ keys first)
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# Razorpay: Dashboard -> Webhooks -> URL http://<server>:9000/api/webhooks/razorpay,
# events: payment.captured, order.paid. Use the secret you set there.
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# Plans shown on the signup page. amount is in paise (499900 = Rs 4,999.00)
BILLING_PLANS=[{"id":"standard","name":"Standard","amount":499900,"currency":"INR","description":"Full QuadStack workspace"}]

# Where clients reach their app. Each client gets the next free port in the range;
# open that whole TCP range once in the EC2 security group.
PUBLIC_HOST=CHANGE_ME_SERVER_IP_OR_DOMAIN
APP_URL_TEMPLATE=http://{host}:{port}
CLIENT_PORT_START=8081
CLIENT_PORT_END=8180
# Client workspaces this server can hold (~600-800 MB RAM each; t3.small ~= 2).
# New signups are refused BEFORE payment once reached.
MAX_CLIENTS=2
PROVISION_TIMEOUT_SECONDS=300
CLIENT_ADMIN_USERNAME=admin


# Bearer token for /api/admin/* (generate with: openssl rand -hex 32)
BILLING_ADMIN_TOKEN=CHANGE_ME
